ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://clip.riseklix.com/#organization\",\"name\":\"RiseKlix\",\"alternateName\":\"Clip by RiseKlix\",\"url\":\"https://clip.riseklix.com/\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://clip.riseklix.com/assets/riseklix-logo-2026.png\",\"width\":1254,\"height\":1254},\"description\":\"A private creator clipping network for India-first short-form campaigns.\",\"foundingDate\":\"2026\",\"areaServed\":\"India\",\"knowsAbout\":[\"creator clipping campaigns in India\",\"creator performance networks\",\"short-form content distribution\",\"YouTube Shorts clipping\",\"Instagram Reels clipping\",\"podcast clipping\",\"Discord campaign operations\",\"clipper verification\",\"campaign link tracking\",\"UPI-friendly creator payouts\"],\"sameAs\":[\"https://discord.gg/skQk3xZcRa\",\"https://riseklix.com\"],\"parentOrganization\":{\"@type\":\"Organization\",\"name\":\"RiseKlix Agency\",\"url\":\"https://riseklix.com\"},\"contactPoint\":{\"@type\":\"ContactPoint\",\"contactType\":\"customer support\",\"url\":\"https://clip.riseklix.com/contact/\"}},{\"@type\":\"WebSite\",\"@id\":\"https://clip.riseklix.com/#website\",\"url\":\"https://clip.riseklix.com/\",\"name\":\"Clip by RiseKlix\",\"publisher\":{\"@id\":\"https://clip.riseklix.com/#organization\"},\"inLanguage\":\"en-IN\",\"potentialAction\":{\"@type\":\"JoinAction\",\"name\":\"Join the Clip by RiseKlix Discord\",\"target\":\"https://discord.gg/skQk3xZcRa\"}},{\"@type\":\"WebPage\",\"@id\":\"https://clip.riseklix.com/data-deletion/#webpage\",\"url\":\"https://clip.riseklix.com/data-deletion/\",\"name\":\"Data Deletion\",\"description\":\"How to request deletion of eligible Clip by RiseKlix Discord bot, campaign, submission, and website data.\",\"isPartOf\":{\"@id\":\"https://clip.riseklix.com/#website\"},\"about\":{\"@id\":\"https://clip.riseklix.com/#organization\"},\"inLanguage\":\"en-IN\",\"datePublished\":\"2026-06-24\",\"dateModified\":\"2026-06-29\"},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://clip.riseklix.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Data Deletion\",\"item\":\"https://clip.riseklix.com/data-deletion/\"}]},{\"@type\":\"SoftwareApplication\",\"@id\":\"https://clip.riseklix.com/data-deletion/#discord-bot\",\"name\":\"Clip by RiseKlix Discord Bot\",\"applicationCategory\":\"BusinessApplication\",\"operatingSystem\":\"Discord\",\"url\":\"https://clip.riseklix.com/data-deletion/\",\"publisher\":{\"@id\":\"https://clip.riseklix.com/#organization\"},\"description\":\"A Discord bot used by Clip by RiseKlix to support creator clipping campaign submissions, public link tracking, view-count snapshots, approval status, and anti-fraud review.\"}]}</script>\n  </head>\n  <body class=\"hub-page legal-page\" data-mode=\"brand\">\n    <a class=\"skip-link\" href=\"#main\">Skip to content</a>\n    <div class=\"page-texture\" aria-hidden=\"true\"></div>\n    <header class=\"site-header\">\n      <a class=\"brand-lockup\" href=\"../index.html\" aria-label=\"Clip by RiseKlix home\">\n        <img class=\"brand-logo\" src=\"../assets/riseklix-logo-2026.png\" width=\"44\" height=\"44\" alt=\"\">\n        <span class=\"brand-copy\">\n          <strong>Clip</strong>\n          <span>by RiseKlix</span>\n        </span>\n      </a>\n      <nav class=\"primary-nav\" aria-label=\"Primary navigation\">\n        <a href=\"../index.html#flow\">Flow</a>\n        <a href=\"../resources/\">Resources</a>\n        <a href=\"../compare/\">Compare</a>\n        <a href=\"../guides/\">Guides</a>\n        <a href=\"../blog/\">Blog</a>\n      </nav>\n      <a class=\"header-cta\" href=\"https://discord.gg/skQk3xZcRa\" target=\"_blank\" rel=\"noopener\">Join Discord</a>\n    </header>\n    <main id=\"main\">\n      <section class=\"hub-hero\">\n        <p class=\"eyebrow\">Data Deletion</p>\n        <h1>Request deletion of eligible bot and campaign data.</h1>\n        <p>Last updated: June 25, 2026. Use this page if you want Clip by RiseKlix to delete eligible personal data connected to your Discord account, campaign submissions, or website interactions.</p>\n        <div class=\"hero-actions\">\n          <a class=\"button button-primary\" href=\"https://discord.gg/skQk3xZcRa\" target=\"_blank\" rel=\"noopener\">Open Discord</a>\n          <a class=\"button button-secondary\" href=\"../privacy/\">Read privacy policy</a>\n        </div>\n      </section>\n      <section class=\"docs-layout\">\n        <article>\n          <h2>Fast request method</h2>\n          <p>Join the Discord server and open a support ticket or message the designated admin channel with the subject \"Data deletion request\". Include your Discord user ID, Discord username, campaign name if known, and any submitted clip URLs you want reviewed.</p>\n        </article>\n        <article>\n          <h2>If you cannot access Discord</h2>\n          <p>Use the <a href=\"../contact/\">Contact</a> page or the RiseKlix Agency website at <a href=\"https://riseklix.com\" target=\"_blank\" rel=\"noopener\">riseklix.com</a> and include \"Clip by RiseKlix data deletion request\" in your message so it can be routed correctly.</p>\n        </article>\n        <article>\n          <h2>What can be deleted</h2>\n          <p>Eligible deletion may include Discord bot records tied to your user ID, Instagram connection records, stored Instagram access tokens, campaign participation records, support tickets, submitted clip links, review notes, and voluntary form information where we can reasonably identify the record and no retention exception applies.</p>\n        </article>\n        <article>\n          <h2>What may stay</h2>\n          <p>We may retain limited records when needed for fraud prevention, security logs, legal obligations, payment/accounting records, dispute resolution, completed campaign reporting, backup integrity, or to enforce server rules. Where possible, retained records may be minimized or anonymized.</p>\n        </article>\n        <article>\n          <h2>Verification</h2>\n          <p>We may ask you to verify that you control the Discord account or submitted links before deleting data. This protects clippers, creators, and clients from unauthorized deletion requests.</p>\n        </article>\n        <article>\n          <h2>Timeline</h2>\n          <p>We aim to acknowledge deletion requests within 7 days and complete eligible deletion within 30 days, unless the request is unusually complex, legally restricted, or requires additional identity verification.</p>\n        </article>\n        <article>\n          <h2>Bot removal from your server</h2>\n          <p>If you installed the RiseKlix bot in a server you control, you can remove the bot from that server at any time through Discord server settings. Removing the bot stops future collection in that server but does not automatically delete historical campaign records.</p>\n        </article>\n        <article>\n          <h2>Instagram deauthorization</h2>\n          <p>You can disconnect Instagram through your Meta or Instagram settings. Meta can notify RiseKlix at <strong>https://clip.riseklix.com/auth/instagram/deauthorize</strong>, after which the bot backend can disable or remove the connected token. You can still submit a deletion request here if you want eligible historical records reviewed.</p>\n        </article>\n        <article>\n          <h2>After deletion</h2>\n          <p>After eligible deletion, some public platform data may still exist on the platform where the clip was posted. You must delete or change those posts directly on YouTube, Instagram, X/Twitter, or the relevant platform.</p>\n        </article>\n      </section>\n    </main>\n    <footer class=\"site-footer\">\n      <div class=\"footer-wordmark\" aria-hidden=\"true\">Clip by RiseKlix</div>\n      <div class=\"footer-inner\">\n        <div class=\"footer-brand\">\n          <img src=\"../assets/riseklix-logo-2026.png\" width=\"82\" height=\"82\" alt=\"\">\n          <p>A private creator clipping network for India-first short-form campaigns.</p>\n          <a class=\"footer-cta\" href=\"https://discord.gg/skQk3xZcRa\" target=\"_blank\" rel=\"noopener\">Join Discord</a>\n        </div>\n        <nav class=\"footer-nav\" aria-label=\"Footer navigation\">\n          <div>\n            <h2>Explore</h2>\n            <a href=\"../resources/\">Resources</a>\n            <a href=\"../compare/\">Compare</a>\n            <a href=\"../guides/\">Guides</a>\n            <a href=\"../blog/\">Blog</a>\n          </div>\n          <div>\n            <h2>Playbooks</h2>\n            <a href=\"../platforms/youtube-shorts-clipper-guide-india.html\">YouTube Shorts</a>\n            <a href=\"../platforms/instagram-reels-clipper-guide-india.html\">Instagram Reels</a>\n            <a href=\"../platforms/podcast-clipping-guide-india.html\">Podcast Clipping</a>\n            <a href=\"../platforms/x-twitter-clipper-guide-india.html\">X/Twitter Clips</a>\n          </div>\n          <div>\n            <h2>Start</h2>\n            <a href=\"../docs/\">Documentation</a>\n            <a href=\"../contact/\">Contact</a>\n            <a href=\"https://discord.gg/skQk3xZcRa\" target=\"_blank\" rel=\"noopener\">Discord Server</a>\n            <a href=\"https://riseklix.com\" target=\"_blank\" rel=\"noopener\">RiseKlix Agency</a>\n          </div>\n          <div>\n            <h2>Legal</h2>\n            <a href=\"../privacy/\">Privacy Policy</a>\n            <a href=\"../terms/\">Terms of Service</a>\n            <a href=\"../data-deletion/\">Data Deletion</a>\n          </div>\n        </nav>\n      </div>\n      <div class=\"footer-bottom\">\n        <span>2026 Clip by RiseKlix. Built for India-first creator clipping.</span>\n        <span class=\"footer-bottom-links\"><a href=\"../sitemap.xml\">Sitemap</a><a href=\"https://riseklix.com\" target=\"_blank\" rel=\"noopener\">riseklix.com</a></span>\n      </div>\n    </footer>\n    <script src=\"../script.js\" defer></script>\n  </body>\n</html>",
  "docs": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <meta name=\"description\" content=\"Operational documentation for Discord-first creator performance campaigns in India.\">\n    <meta name=\"robots\" content=\"index, follow, max-image-preview:large\">\n    <link rel=\"canonical\" href=\"https://clip.riseklix.com/docs/\">\n    <meta property=\"og:type\" content=\"website\">\n    <meta property=\"og:title\" content=\"Documentation | Clip by RiseKlix\">\n    <meta property=\"og:description\" content=\"Operational documentation for Discord-first creator performance campaigns in India.\">\n    <meta property=\"og:url\" content=\"https://clip.riseklix.com/docs/\">\n    <meta property=\"og:image\" content=\"https://clip.riseklix.com/assets/riseklix-logo-2026.png\">\n    <meta property=\"og:site_name\" content=\"Clip by RiseKlix\">\n    <meta name=\"twitter:card\" content=\"summary_large_image\">\n    <meta name=\"twitter:title\" content=\"Documentation | Clip by RiseKlix\">\n    <meta name=\"twitter:description\" content=\"Operational documentation for Discord-first creator performance campaigns in India.\">\n    <meta name=\"twitter:image\" content=\"https://clip.riseklix.com/assets/riseklix-logo-2026.png\">\n    <title>Documentation | Clip by RiseKlix</title>\n    <link rel=\"icon\" href=\"../assets/riseklix-logo-2026.png\">\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=IBM+Plex+Mono:wght@500;600;700&family=Inter+Tight:wght@500;600;700;800;900&display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"../styles.css\">\n    <script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\